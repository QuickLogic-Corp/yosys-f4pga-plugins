
autoidx 1785

attribute \top 1
attribute \src "sdffr_inst.v:25.1-44.10"
module \direct_sdffr

  attribute \src "sdffr_inst.v:26.17-26.20"
  wire input 1 \clk

  attribute \src "sdffr_inst.v:28.17-28.18"
  wire input 3 \d

  attribute \src "sdffr_inst.v:32.10-32.15"
  wire \d_int

  attribute \src "sdffr_inst.v:29.17-29.22"
  wire input 4 \other

  attribute \src "sdffr_inst.v:33.10-33.11"
  wire \q

  attribute \src "sdffr_inst.v:30.17-30.20"
  wire output 5 \q_o

  attribute \src "sdffr_inst.v:27.17-27.22"
  wire input 2 \rst_n

  cell $lut \d_int_$lut_Y
    parameter \LUT 4'0110
    parameter \WIDTH 2
    connect \A { \d \other }
    connect \Y \d_int
  end

  attribute \module_not_derived 1
  attribute \src "sdffr_inst.v:38.14-43.6"
  cell \io_sdffr \ff
    connect \C \clk
    connect \D \d_int
    connect \Q \q
    connect \R \rst_n
  end

  cell $lut \q_o_$lut_Y
    parameter \LUT 4'1000
    parameter \WIDTH 2
    connect \A { \q \other }
    connect \Y \q_o
  end
end
