# Annotated IP netlist as the catalog ships it: one .model, REL_* attributes
# on the cells, no REL_MACRO_NAME yet.
.model rel_ip
.inputs clk d
.outputs q k
.names $false
.names $true
1
.names $false k
1 1
.names d n_inv
0 1
.attr REL_MACRO_TYPE "TEST_MACRO"
.attr REL_X "0"
.attr REL_Y "0"
.attr REL_SUBTILE "0"
.subckt dffre C=clk D=n_inv E=$true Q=q R=$true
.attr REL_MACRO_TYPE "TEST_MACRO"
.attr REL_X "0"
.attr REL_Y "0"
.attr REL_SUBTILE "1"
.attr SITE_PATH "clb[0][default]/ff[0][DFFRE]/DFFRE[0]"
.end
