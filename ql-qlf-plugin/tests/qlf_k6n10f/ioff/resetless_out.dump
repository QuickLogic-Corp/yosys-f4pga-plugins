
autoidx 2677

attribute \top 1
attribute \src "ioff.v:58.1-65.10"
module \resetless_out

  attribute \src "ioff.v:60.17-60.18"
  wire input 2 \a

  attribute \src "ioff.v:61.17-61.18"
  wire input 3 \b

  attribute \src "ioff.v:59.17-59.20"
  wire input 1 \clk

  attribute \src "ioff.v:62.17-62.20"
  wire output 4 \q_o

  attribute \src "ioff.v:64.5-64.40"
  wire \q_o_io_sdffr_Q_D

  cell $lut \b_$lut_A
    parameter \LUT 4'1000
    parameter \WIDTH 2
    connect \A { \a \b }
    connect \Y \q_o_io_sdffr_Q_D
  end

  attribute \keep 1
  cell \io_sdffr \q_o_io_sdffr_Q
    connect \C \clk
    connect \D \q_o_io_sdffr_Q_D
    connect \Q \q_o
    connect \R 1'1
  end
end
