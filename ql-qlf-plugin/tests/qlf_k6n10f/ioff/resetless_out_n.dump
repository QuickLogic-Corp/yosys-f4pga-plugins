
autoidx 3557

attribute \top 1
attribute \src "ioff.v:68.1-75.10"
module \resetless_out_n

  attribute \src "ioff.v:70.17-70.18"
  wire input 2 \a

  attribute \src "ioff.v:71.17-71.18"
  wire input 3 \b

  attribute \src "ioff.v:69.17-69.20"
  wire input 1 \clk

  attribute \src "ioff.v:72.17-72.20"
  wire output 4 \q_o

  attribute \src "ioff.v:74.5-74.40"
  wire \q_o_io_sdffnr_Q_D

  cell $lut \b_$lut_A
    parameter \LUT 4'1000
    parameter \WIDTH 2
    connect \A { \a \b }
    connect \Y \q_o_io_sdffnr_Q_D
  end

  attribute \keep 1
