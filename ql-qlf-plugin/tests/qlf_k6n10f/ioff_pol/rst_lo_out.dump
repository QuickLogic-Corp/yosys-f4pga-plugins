
autoidx 12562

attribute \top 1
attribute \src "ioff_pol.v:200.1-210.10"
module \rst_lo_out

  attribute \src "ioff_pol.v:203.17-203.18"
  wire input 3 \a

  attribute \src "ioff_pol.v:204.17-204.18"
  wire input 4 \b

  attribute \src "ioff_pol.v:201.17-201.20"
  wire input 1 \clk

  attribute \src "ioff_pol.v:205.17-205.20"
  wire output 5 \q_o

  wire \q_o_io_sdffr_Q_D

  attribute \src "ioff_pol.v:202.17-202.22"
  wire input 2 \rst_n

  cell $lut \b_$lut_A
    parameter \LUT 4'1000
    parameter \WIDTH 2
    connect \A { \a \b }
    connect \Y \q_o_io_sdffr_Q_D
  end

  attribute \keep 1
  cell \io_sdffr \q_o_io_sdffr_Q
    connect \C \clk
    connect \D \q_o_io_sdffr_Q_D
    connect \Q \q_o
    connect \R \rst_n
  end
end
