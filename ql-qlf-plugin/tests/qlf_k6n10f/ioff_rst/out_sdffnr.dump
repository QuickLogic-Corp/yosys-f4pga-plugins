
autoidx 3586

attribute \top 1
attribute \src "ioff_rst.v:71.1-81.10"
module \out_sdffnr

  attribute \src "ioff_rst.v:74.17-74.18"
  wire input 3 \a

  attribute \src "ioff_rst.v:75.17-75.18"
  wire input 4 \b

  attribute \src "ioff_rst.v:72.17-72.20"
  wire input 1 \clk

  attribute \src "ioff_rst.v:76.17-76.20"
  wire output 5 \q_o

  wire \q_o_io_sdffnr_Q_D

  attribute \src "ioff_rst.v:73.17-73.22"
  wire input 2 \rst_n

  cell $lut \b_$lut_A
    parameter \LUT 4'1000
    parameter \WIDTH 2
