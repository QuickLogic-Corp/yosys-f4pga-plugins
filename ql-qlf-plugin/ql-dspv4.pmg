// ql-dspv4.pmg -- DSP-V4 inference pattern (Phase 2, IN-5).
//
// Matches the five Phase 2 idioms, from the smallest outwards:
//
//   $mul                              -> MULT
//   $mul -> $add(C)                   -> MULT_ADD_C
//   $mul -> $sub(C - prod)            -> MULT_SUB_C
//   $mul -> $add -> $dff (feedback)   -> MULT_ACC,   PREG=1
//   $mul -> $add(C) -> $add -> $dff   -> MULT_ACC_C, PREG=1
//
// `add` and `ff` are optional because a bare multiply is a valid match; the
// classification in ql-dspv4.cc decides which mode a given shape is.
//
// The nusers guards are load-bearing, not tidiness. Absorbing a cell whose
// output another cell still reads means the DSP swallows a value someone else
// needs, and the netlist is quietly wrong -- it still synthesises, packs and
// routes.
//
// The bound is 2: nusers counts the driver plus the readers, so 2 means
// "driven here, read in exactly one place" -- the cell this pattern is about to
// absorb it into. At 3 a product that also leaves the module still matched, and
// the DSP would swallow it.
//
// Where each guard sits matters as much as its bound. pmgen emits `select`
// inside the index-BUILD loop and `filter` inside the MATCH loop, so a `select`
// on the anchor `mul` does not reject the adder -- it removes the multiply from
// the candidate index entirely, the pattern never fires, and the `optional`
// fallback to a bare MULT never gets a chance. `wire prod = a*b` feeding two
// adders then produced no DSP at all and was not even counted as left soft.
//
// So: the product's fanout is checked with `filter` on the matches that would
// absorb it, and the anchor carries no fanout guard. On the non-anchor matches
// (`add`, `acc`) a `select` is still correct, because excluding one candidate
// there degrades to the next smaller shape rather than killing the match.

pattern ql_dspv4

state <IdString> add_ba
state <IdString> acc_ba
state <IdString> add_mul_port
state <bool> add_is_sub

state <int> mul_nusers
state <int> add_nusers
state <int> mff_nusers
state <int> padd_a_nusers
state <int> padd_b_nusers

// The multiply. Everything else hangs off this.
//
// No fanout guard here -- see the header. The count is recorded so the matches
// that would absorb the product can check it at match time.
match mul
    select mul->type.in($mul)
    set mul_nusers nusers(port(mul, \Y))
endmatch

// Optional register between the pre-adder and the multiplier -- the DSP's AD
// stage (ADREG). Phase 4 step 5, the other half of DREG.
//
//     always @(posedge clk) ad <= m + x;
//     assign p = ad * b;
//
// Matched BEFORE padd_* because padd_* has to index through it: with this flop
// present the multiplier operand is the flop's Q, not the adder's Y, so an
// index straight onto the adder finds nothing and the pre-adder is not inferred
// at all -- the addition stays in fabric with no refusal logged, because the
// pattern was never offered the shape.
//
// $dffe / $sdffe are excluded: QL_DSP4_AD_DFFR_32 has no clock enable, the same
// reason the M bank excludes them.
match adff_a
    // $dff only. QL_DSP4_AD_DFFR_32 takes the cell-wide RSTN, which this
    // path does not wire, so absorbing a resettable flop would drop its
    // reset silently -- measured as 158/300 wrong vectors before this
    // restriction. A reset AD register stays in fabric instead.
    select adff_a->type.in($dff)
    select param(adff_a, \CLK_POLARITY).as_bool()
    index <SigBit> port(adff_a, \Q)[0] === port(mul, \A)[0]
    filter GetSize(port(adff_a, \Q)) >= GetSize(port(mul, \A))
    filter nusers(port(adff_a, \Q)) <= 2
    optional
endmatch

match adff_b
    // $dff only. QL_DSP4_AD_DFFR_32 takes the cell-wide RSTN, which this
    // path does not wire, so absorbing a resettable flop would drop its
    // reset silently -- measured as 158/300 wrong vectors before this
    // restriction. A reset AD register stays in fabric instead.
    select adff_b->type.in($dff)
    select param(adff_b, \CLK_POLARITY).as_bool()
    index <SigBit> port(adff_b, \Q)[0] === port(mul, \B)[0]
    filter GetSize(port(adff_b, \Q)) >= GetSize(port(mul, \B))
    filter nusers(port(adff_b, \Q)) <= 2
    optional
endmatch

// Optional pre-adder feeding a multiply operand -- the DSP's own front-end
// adder, which computes D +/- (A|B) and hands the result to one multiplier port.
// Phase 4 (aurora2 docs/specs/dspv4-preadder-inference/).
//
//     assign y = (d + a) * b;     ->  one QL_DSP4, zero fabric adders
//
// TWO matches rather than one with a `choice`, and that is forced by pmgen
// rather than chosen. `choice` is emitted inside the index-BUILD loop and varies
// the CANDIDATE cell, so the index key is computed per (candidate, choice). At
// match time pmgen does exactly ONE lookup, with the key built from the
// already-matched cells -- there is no iteration over alternatives on that side.
// So a `choice` can say "either operand of the cell being matched", which is
// what `add` below uses it for, but it cannot say "either operand of `mul`",
// because `mul` is already bound and sits on the lookup side. Hence one match
// per multiplier port, each with a fixed RHS.
//
// The anchor deliberately stays on `mul`. Anchoring on the pre-adder instead
// would make every bare multiply enumerate a pre-adder that is usually not
// there, and -- worse -- a `select` on a new anchor is the item 1 failure:
// the candidate is dropped from the index entirely and the multiply infers
// NOTHING, rather than degrading to a plain MULT.
//
// The sole-reader filter is load-bearing. Absorbing the pre-adder makes its sum
// vanish inside the DSP, so a second reader would be left with no driver.
//
// The containment filters (rather than an exact `===`) follow `mff` and `add`.
// Measured on the prepare sequence, `wreduce` narrows the $add's Y and the
// $mul's operand to the SAME SigSpec, so an exact match would work today for
// the shapes probed -- but items 9, 15 and 18 were all this assumption failing
// in three different places, and the tolerant form costs nothing.
match padd_a
    // $neg is the unary form: AD = 0 - A, which is NEG_*_MULT_*. It has no
    // B port, so ql-dspv4.cc reads its single operand rather than two.
    select padd_a->type.in($add, $sub, $neg)
    index <SigBit> port(padd_a, \Y)[0] === (adff_a != nullptr ? port(adff_a, \D)[0] : port(mul, \A)[0])
    filter GetSize(adff_a != nullptr ? port(adff_a, \D) : port(mul, \A)) >= GetSize(port(padd_a, \Y))
    filter (adff_a != nullptr ? port(adff_a, \D) : port(mul, \A)).extract(0, GetSize(port(padd_a, \Y))) == port(padd_a, \Y)
    // Bound 3, not 2, ONLY so the squaring shape can be seen: (m + x) * (m + x)
    // has one sum feeding BOTH multiplier ports, so nusers is 3 and a bound of
    // 2 refused it outright, leaving the adder in fabric. ql-dspv4.cc refuses
    // any other 3-reader case -- the sum must leave on P, and a third reader
    // would lose its driver.
    filter nusers(port(padd_a, \Y)) <= 3
    set padd_a_nusers nusers(port(padd_a, \Y))
    optional
endmatch

// The B-path mirror. When BOTH match -- `(d + a) * (e + b)` -- the DSP has only
// one pre-adder, so ql-dspv4.cc refuses that combination and pmgen then offers
// the shapes with one side null, which do fuse. Refusing rather than silently
// picking one is what keeps the choice visible in the log.
match padd_b
    // $neg is the unary form: AD = 0 - A, which is NEG_*_MULT_*. It has no
    // B port, so ql-dspv4.cc reads its single operand rather than two.
    select padd_b->type.in($add, $sub, $neg)
    index <SigBit> port(padd_b, \Y)[0] === (adff_b != nullptr ? port(adff_b, \D)[0] : port(mul, \B)[0])
    filter GetSize(adff_b != nullptr ? port(adff_b, \D) : port(mul, \B)) >= GetSize(port(padd_b, \Y))
    filter (adff_b != nullptr ? port(adff_b, \D) : port(mul, \B)).extract(0, GetSize(port(padd_b, \Y))) == port(padd_b, \Y)
    // Bound 3, not 2, ONLY so the squaring shape can be seen: (m + x) * (m + x)
    // has one sum feeding BOTH multiplier ports, so nusers is 3 and a bound of
    // 2 refused it outright, leaving the adder in fabric. ql-dspv4.cc refuses
    // any other 3-reader case -- the sum must leave on P, and a third reader
    // would lose its driver.
    filter nusers(port(padd_b, \Y)) <= 3
    set padd_b_nusers nusers(port(padd_b, \Y))
    optional
endmatch

// Optional register between the multiply and the adder -- the DSP's M stage.
//
// Only meaningful when an adder follows: it registers the product *before* the
// ALU. With no adder the product register is the result register, and that
// belongs in P, which the `ff` match below already handles. ql-dspv4.cc drops
// this match when `add` did not match, for exactly that reason -- and because
// pmgen can otherwise hand the same flop to both `mff` and `ff`.
//
// $dffe / $sdffe are deliberately excluded. The M bank is QL_DSP4_M_DFFR_50
// (with MV_DFFR_43 / MK_DFFR for the multiplier's other two outputs) and its
// port set is {D, R, clk} -- there is NO clock enable, unlike the output flop
// which has CEP. An enabled flop has nowhere to put its enable here.
//
// Absorbing this flop makes the product vanish inside the DSP, so the same
// sole-reader rule the adder needs applies to the multiply's Y.
// The flop's D is NOT required to be the product signal itself -- it only has
// to CONTAIN it, in the low bits, with sign padding above. wreduce narrows the
// multiply when the upper product bits reach nothing downstream but leaves the
// register at its declared width, so D and Y end up different widths with the
// gap filled by copies of the sign bit. An exact `===` index silently never
// offered the flop at all: gng kept its product register in fabric while the
// same module in isolation absorbed it.
//
// Hence: index on one bit, then check the product occupies D's low bits. The
// padding itself is verified in ql-dspv4.cc, which has the signedness to hand.
//
// Worked example, diagrams and the reasoning for why absorbing the wider
// register is sound: docs/dspv4-mreg-product-width.md
//
// $dffe / $sdffe stay excluded: QL_DSP4_M_DFFR_50's port set is {D, R, clk},
// with no clock enable, unlike the output flop's CEP.
match mff
    select mff->type.in($dff, $sdff)
    select param(mff, \CLK_POLARITY).as_bool()
    index <SigBit> port(mff, \D)[0] === port(mul, \Y)[0]
    filter GetSize(port(mff, \D)) >= GetSize(port(mul, \Y))
    filter port(mff, \D).extract(0, GetSize(port(mul, \Y))) == port(mul, \Y)
    filter mul_nusers <= 2
    set mff_nusers nusers(port(mff, \Q))
    optional
endmatch

// Optional negate on the product -- `p = -(x * x)`. Phase 4, REQ-B3.
//
// The ALU computes Z - (X + Y + CIN). With Z = 0 and the multiplier on X:Y,
// ALUMODE=11 gives P = -M for free, in the cell that already holds the
// multiply. Without this the negate is a fabric carry chain the width of the
// product hanging off a DSP that could have done it.
//
// The mode is SQ_A_NEG (5, 3, 0, ..., AMULTSEL=BMULTSEL=1), and the SQUARING
// form is the only one there is: the spreadsheet has no alumode=3 control
// word with AMULTSEL=BMULTSEL=0, so a negated product of two DIFFERENT
// operands cannot be expressed. ql-dspv4.cc refuses everything but x * x and
// lets the matcher offer the shape again without this match, which is how
// `-(a * b)` still gets its DSP with only the negate left soft.
//
// `0 - x*x` does not arrive here. yosys leaves that as a $sub with a constant
// zero operand, which the `add` match below already takes as MULT_SUB_C -- one
// cell, at the cost of the C port. Only the unary form survives as $neg.
//
// Indexed straight onto the product, deliberately not through `mff`. With no
// adder the M register is not absorbable (emit() drops mff_cell unless `add`
// matched, because the product register belongs in P), so absorbing a negate
// that reads the REGISTERED product while the DSP negates the unregistered one
// would shift the result by a cycle. When an M register is present this match
// simply does not fire, and pmgen still offers the enumeration without it.
//
// Same containment tolerance as `mff` and `add`: wreduce narrows the multiply
// and leaves the negate's operand sign-padded above it.
match mneg
    select mneg->type.in($neg)
    index <SigBit> port(mneg, \A)[0] === port(mul, \Y)[0]
    filter GetSize(port(mneg, \A)) >= GetSize(port(mul, \Y))
    filter port(mneg, \A).extract(0, GetSize(port(mul, \Y))) == port(mul, \Y)
    // Absorbing the negate makes the product internal to the DSP, so it must
    // have exactly one reader -- this cell.
    filter mul_nusers <= 2
    optional
endmatch

// Optional add/sub consuming the product. `choice` covers commutativity; for
// $sub the side matters and is recorded, because C - A*B has a control word
// (MULT_SUB_C) while A*B - C does not -- see the classification.
//
// The indexed operand is the M register's Q when one matched, otherwise the
// product itself. Same one-statement-per-line constraint as `ff` below.
match add
    select add->type.in($add, $sub)
    choice <IdString> AB {\A, \B}
    define <IdString> BA (AB == \A ? \B : \A)
    // The operand only has to CONTAIN the product in its low bits, with sign
    // padding above -- the same tolerance `mff` needs, for the same reason.
    // wreduce narrows the multiply when the upper product bits reach nothing,
    // but leaves the adder's operand at its declared width, so the adder reads
    // the product sign-extended. An exact `===` index then never matches and the
    // adder silently stays in fabric: dsp_multadd fuses standalone (mul.Y 36 vs
    // add.B 36) and does not when flattened into dsp_multadd_wrap (36 vs 48).
    // That cost 29 of the 102 dsp testcases their adder fusion.
    //
    // ql-dspv4.cc checks the padding really is a sign extension.
    // Written longhand rather than with `define`: pmgen emits a define into the
    // index-BUILD scope, where the matched cells are not in scope yet.
    index <SigBit> port(add, AB)[0] === (mff != nullptr ? port(mff, \Q)[0] : port(mul, \Y)[0])
    filter GetSize(port(add, AB)) >= GetSize(mff != nullptr ? port(mff, \Q) : port(mul, \Y))
    filter port(add, AB).extract(0, GetSize(mff != nullptr ? port(mff, \Q) : port(mul, \Y))) == (mff != nullptr ? port(mff, \Q) : port(mul, \Y))
    // Absorbing this adder makes the DSP produce the SUM, so whatever feeds it
    // stops appearing in the netlist. A second reader would be left with no
    // driver. The net to guard is the one this adder actually reads: the M
    // register's Q when it matched, the product otherwise. Checked here rather
    // than on `mul` so that a shared product still reaches the bare-MULT branch.
    filter (mff != nullptr ? mff_nusers : mul_nusers) <= 2
    // NOTE: there is deliberately no guard on this adder's own output fanout.
    // The sum leaves the DSP on P, so any number of readers can have it. It only
    // needs guarding when something downstream absorbs it as well -- `acc` taking
    // it as an operand, or `ff` registering it -- and those two cases are covered
    // where they arise: `ff` carries its own nusers filter, and ql-dspv4.cc checks
    // add_nusers when it decides to absorb `acc`.
    //
    // A `select nusers(port(add, \Y)) <= 2` here refused oc8051_top's
    // `mul_result = mul_result1 + shifted`, whose sum has three readers (des1,
    // des2 and the tmp_mul feedback) and no output register -- a textbook
    // MULT_ADD_C that fell back to a bare multiply for no reason.
    set add_nusers nusers(port(add, \Y))
    set add_ba BA
    set add_mul_port AB
    set add_is_sub add->type == $sub
    optional
endmatch

// Optional second adder, for A*B + P + C.
//
// Only meaningful when the chain ends in an accumulator flop. pmgen matches this
// before `ff`, so the constraint cannot be expressed here -- ql-dspv4.cc gates
// it on `ff` and must keep doing so. See the comment there.
//
// Yosys builds `p + a*b + c` LEFT-associatively: the first adder takes the
// accumulator feedback and the product, the second adds C on top. So this match
// is the C adder, and the flop's feedback still lands on `add` -- the reverse of
// what the shape sketch in the plan implies. Verified against a dumped netlist
// rather than assumed.
match acc
    select acc->type.in($add)
    choice <IdString> AB {\A, \B}
    define <IdString> BA (AB == \A ? \B : \A)
    index <SigSpec> port(acc, AB) === (add == nullptr ? SigSpec() : port(add, \Y))
    // No fanout guard here either, for the same reason as `add`: this sum leaves
    // on P. `acc` is only ever absorbed together with `ff` (see ql-dspv4.cc), and
    // `ff`'s own filter guards the net it registers.
    set acc_ba BA
    optional
endmatch

// Optional flop on the result. Two different shapes land here:
//
//   accumulator     Q feeds `add`'s other operand, so the DSP adds to its own
//                   previous output -- MULT_ACC / MULT_ACC_C.
//   output register a plain pipeline register on the result -- the mode is
//                   whatever the combinational shape was, with PREG=1.
//
// Both use the DSP's P register, so both are worth absorbing; only the feedback
// tells them apart, and that test lives in ql-dspv4.cc rather than here. An
// earlier version indexed on `port(ff, \Q) === port(add, add_ba)` to force the
// accumulator case, which also meant a pipeline register on the result never
// matched at all and stayed in fabric -- the cost that made the registered
// cascade_* designs unroutable.
//
// D comes from the last cell in the chain: `acc` for the three-input form,
// otherwise `add`, otherwise `mneg`, otherwise the multiply itself. The
// bare-multiply branch is what lets `p <= a * b` be absorbed, and the `mneg`
// branch is the same thing for `p <= -(x * x)` -- without it the negate is
// absorbed but its output register is not, and PREG is left on the table.
//
// This index line is long on purpose: pmgen parses one statement per line, so
// wrapping it turns the continuation into an unrecognised statement.
//
// Every DSP register bank is rising-edge (dsp4_logical_map.v instantiates
// QL_DSP4_*_DFFRE_* with .clk(CLK) and no inversion), and emit() wires the
// flop's CLK straight through. So a falling-edge flop absorbed here would be
// re-timed onto the opposite edge with nothing to show it: an
// `always @(negedge clk) p <= a*b` produced a QL_DSP4_ACC_DFFRE_64 clocked on
// the rising edge. collect_flops() checks CLK_POLARITY for the OPERAND chains;
// this is the same check for the output flop.
match ff
    select ff->type.in($dff, $dffe, $sdff, $sdffe)
    select param(ff, \CLK_POLARITY).as_bool()
    index <SigSpec> port(ff, \D) === (acc != nullptr ? port(acc, \Y) : add != nullptr ? port(add, \Y) : mneg != nullptr ? port(mneg, \Y) : port(mul, \Y))
    // The value this flop registers must have exactly one reader -- this flop.
    // Absorbing it makes the DSP drive Q instead of D, so any other reader of D
    // loses its driver. When `add` or `acc` matched, their own nusers selects
    // already cover it; when neither did, `ff` is indexed straight onto the
    // product and this is the only thing standing between a shared product and
    // an undriven net.
    filter nusers(port(ff, \D)) <= 2
    optional
endmatch

// Optional SECOND output register stage, for `mul -> reg -> reg` with no adder:
//
//     always @(posedge clk) prod1 <= a * b;
//     always @(posedge clk) p     <= prod1;
//
// The DSP has two register positions between the multiplier and P, so both
// stages come inside -- the first in the M bank, the second in P. ql-dspv4.cc
// does that by reassigning: the flop `ff` matched becomes the M register and
// this one becomes the P register, so the rest of emit() needs no special case.
//
// Indexed on `ff`'s Q rather than on the product, so this cannot bind the same
// cell as `ff`. An earlier attempt made `ff`'s own index depend on `mff`
// instead; that created a covering where `mff` bound the product register and
// nothing could use it, and the matcher did not offer the alternative -- the
// multiply was left soft entirely. Adding a separate match leaves every
// existing shape's enumeration untouched.
//
// $dffe / $sdffe are excluded because the M bank has no clock enable, and the
// first stage is the one that lands there.
//
// Only meaningful without an adder: with one, both stages sit downstream of the
// ALU and only P is reachable. ql-dspv4.cc gates on that.
match ff2
    select ff2->type.in($dff, $sdff)
    select param(ff2, \CLK_POLARITY).as_bool()
    index <SigSpec> port(ff2, \D) === (ff == nullptr ? SigSpec() : port(ff, \Q))
    filter nusers(port(ff2, \D)) <= 2
    optional
endmatch

code
    accept;
endcode
